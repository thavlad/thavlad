/* css/shop.css */
.shop-container {
    display: flex;
    gap: 2rem;
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1rem;
}

.filter-sidebar {
    width: 280px;
    flex-shrink: 0;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    flex: 1;
}

/* Responsive design for tablets and mobile */
@media (max-width: 768px) {
    .shop-container {
        flex-direction: column;
    }
    .filter-sidebar {
        width: 100%;
    }
}
